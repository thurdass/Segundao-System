# Portas expostas no computador local
MYSQL_PORT=3307
BACKEND_PORT=8081
FRONTEND_PORT=5174

# Banco de dados
MYSQL_DATABASE=2a_system
MYSQL_USER=segundao
MYSQL_PASSWORD=defina_uma_senha_local
MYSQL_ROOT_PASSWORD=defina_outra_senha_local

# Segurança da aplicação
JWT_SECRET=defina_uma_chave_jwt_local_com_pelo_menos_32_caracteres
JWT_EXPIRATION_HOURS=24
DDL_AUTO=update

# Bootstrap opcional do primeiro administrador
# Ative somente depois de definir credenciais locais.
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_USERNAME=thurdas
INITIAL_ADMIN_PASSWORD=defina_uma_senha_local_com_pelo_menos_8_caracteres
INITIAL_ADMIN_DISPLAY_NAME=Initial Administrator
